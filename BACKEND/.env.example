# BACKEND/.env.example
# Copy this to .env and fill in your values

PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/stutrack?retryWrites=true&w=majority

JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars

# Cloudinary (for profile photos)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email via Brevo SMTP (https://app.brevo.com → SMTP & API → SMTP)
# EMAIL_USER = your Brevo account email
# EMAIL_PASS = your Brevo SMTP key (NOT your Brevo login password)
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_brevo_smtp_key_here

# Frontend URL for CORS (your Vercel URL after deployment)
CLIENT_URL=https://your-frontend-app.vercel.app

# Optional: GitHub token to raise API rate limit from 60 to 5000 req/hr
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxx
