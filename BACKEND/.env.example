# BACKEND/.env.example — copy to .env for local dev
# On Render: add each of these as Environment Variables

PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/stutrack?retryWrites=true&w=majority

# JWT — any long random string (min 32 chars)
JWT_SECRET=some_very_long_random_secret_string_here

# Cloudinary — from cloudinary.com dashboard
CLOUD_NAME=your_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Email via Brevo SMTP — from app.brevo.com → SMTP & API → SMTP tab
# EMAIL_USER = your login email on Brevo
# EMAIL_PASS = the SMTP Key shown on that page (NOT your Brevo login password)
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_brevo_smtp_key

# Your Vercel frontend URL (add this after deploying frontend)
CLIENT_URL=https://your-app.vercel.app

# Optional: raises GitHub API rate limit from 60 to 5000 req/hr
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
