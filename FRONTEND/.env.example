# FRONTEND/.env.example
# For local dev: copy this to .env
# For Vercel: add these as Environment Variables in the Vercel dashboard

# Your deployed backend URL (no trailing slash)
VITE_API_URL=https://your-backend.onrender.com

# Secret code required on the professor login page (/prof-access-9x2k)
# Change this to something only you know — e.g. YourCollege@Prof2024
# Set this same value in Vercel environment variables
VITE_PROF_SECRET=prof@stutrack
